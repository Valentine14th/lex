LET DataProcessing(_p9 : string, _p10 : string, _p11 : string, _p12 : string) = ∃u. (ReadData(_p11, _p12, u) ∨ WriteData(_p11, _p12, u); _p10 <- "MyCompany"; _p9 <- "MyCompany") IN LET GiveConsent(_p3 : string, _p4 : string, _p5 : string) = ReceiveConsentOwner(_p3) ∧ ReceiveConsent("statistics"); _p5 <- "MyCompany"; _p4 <- "analytics" IN LET IsCollection(_p6 : string) = ∃t. ∃u. (ReadData(_p6, t, u) ∨ WriteData(_p6, t, u)) ∧ ((_p6 = "ingress") = 1) IN LET IsFair(_p21 : string) = ⊤ IN LET IsNecessaryForLegitimateInterest(_p16 : string, _p17 : string, _p18 : int) = ⊥ IN LET IsOverridenByDataSubjectInterests(_p13 : string, _p14 : int, _p15 : string) = ⊥ IN LET IsTransparent(_p19 : string, _p20 : string) = ⊤ IN LET PersonalData(_p7 : string, _p8 : string) = ∃f. (ReadData(f, _p7, _p8) ∨ WriteData(f, _p7, _p8)) ∧ ((_p7 = "ip") = 1 ∨ (_p7 = "user_agent") = 1) IN LET Exception3(d : string, ds : string, e : string, i : int)? = PersonalData(d, ds) ∧ IsOverridenByDataSubjectInterests(e, i, ds) IN LET IsLawful(_p2 : string) = (∃c. ∃d. ∃ds. ∃pr. DataProcessing(pr, c, _p2, d) ∧ PersonalData(d, ds)) ∨ (∃c. ∃d. ∃ds. ∃e. ∃i. ∃p. DataProcessing(p, c, _p2, d) ∧ IsNecessaryForLegitimateInterest(_p2, e, i) ∧ ¬Exception3(d, ds, e, i)) IN □[0s,∞) (∀a. ∀c. ∀d. ∀ds. ∀pr. DataProcessing(pr, c, a, d) ∧:L IsCollection(a) ∧:L PersonalData(d, ds) →:L (∃p. ⧫[0s,∞) GiveConsent(ds, p, c))) ∧:R □[0s,∞) (∀a. ∀c. ∀d. ∀ds. ∀p. DataProcessing(p, c, a, d) ∧:L PersonalData(d, ds) →:L IsLawful(a) ∧ IsFair(a) ∧ IsTransparent(a, ds))