LET DataProcessing(_p9 : string, _p10 : string, _p11 : string, _p12 : int)- = ReadData(_p11, _p12) ∨:L WriteData(_p11, _p12); _p10 <- "MyCompany"; _p9 <- "MyCompany" IN LET GiveConsent(_p3 : int, _p4 : string, _p5 : string) = ReceiveConsentSignal(_p3); _p5 <- "MyCompany"; _p4 <- "analytics" IN LET IsCollection(_p6 : string) = Collect(_p6) IN LET IsFair(_p21 : string) = ⊤ IN LET IsNecessaryForLegitimateInterest(_p16 : string, _p17 : string, _p18 : int) = ⊥ IN LET IsOverridenByDataSubjectInterests(_p13 : string, _p14 : int, _p15 : int) = ⊥ IN LET IsTransparent(_p19 : string, _p20 : int) = ⊤ IN LET PersonalData(_p7 : int, _p8 : int) = ∃t. DataItem(_p7, t, _p8) ∧ ((t = "ip_address") = 1 ∨ (t = "user_agent") = 1) IN LET Exception3(d : int, ds : int, e : string, i : int) = PersonalData(d, ds) ∧ IsOverridenByDataSubjectInterests(e, i, ds) IN LET IsLawful(_p2 : string) = (∃c. ∃d. ∃ds. ∃pr. DataProcessing(pr, c, _p2, d) ∧ PersonalData(d, ds)) ∨ (∃c. ∃d. ∃ds. ∃e. ∃i. ∃p. DataProcessing(p, c, _p2, d) ∧ IsNecessaryForLegitimateInterest(_p2, e, i) ∧ ¬Exception3(d, ds, e, i)) IN □[0s,∞) (∀a. ∀c. ∀d. ∀ds. ∀pr. DataProcessing(pr, c, a, d) ∧:L IsCollection(a) ∧:L PersonalData(d, ds) →:L (∃p. ⧫[0s,∞) GiveConsent(ds, p, c))) ∧:R □[0s,∞) (∀a. ∀c. ∀d. ∀ds. ∀p. DataProcessing(p, c, a, d) ∧:L PersonalData(d, ds) →:L IsLawful(a) ∧ IsFair(a) ∧ IsTransparent(a, ds))