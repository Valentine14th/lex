let Exception14(a) = betrifft(a, "Verweigerung der Ermächtigung zur Strafverfolgung von Behördenmitgliedern oder von Bundespersonal")
let Exception13(a, bew) = ((((gebiet(a, "Asyl") ∧ ⧫ trifft("kantonale Vorinstanz", a)) ∧ betrifft(a, bew)) ∧ bewilligung(bew))
        ∧ ¬raeumtAnspruchEin("Bundesrecht", bew)) ∧ ¬raeumtAnspruchEin("Völkerrecht", bew)
let Exception12(a) = (gebiet(a, "Asyl") ∧ ⧫ trifft("Bundesverwaltungsgericht", a))
        ∧ ¬∃p. ∃s. (betrifftPerson(a, p) ∧ suchtSchutz(p, s) ∧ ⧫ stelltAuslieferungsersuchen(s, p))
let Exception11(a) = gebiet(a, "Ausländerrecht") ∧ (betrifft(a, "Verlängerung der Grenzgängerbewilligung")
        ∨ betrifft(a, "Kantonswechsel") ∨ betrifft(a, "Stellenwechsel von Personen mit Grenzgängerbewilligung")
        ∨ betrifft(a, "Erteilung von Reisepapieren an schriftenlose AusländerInnen"))
let Exception10(a) = gebiet(a, "Ausländerrecht") ∧ betrifft(a, "Abweichungen von den Zulassungsvoraussetzungen")
let Exception9(a) = gebiet(a, "Ausländerrecht") ∧ (betrifft(a, "Ausweisung (nach Art. 121 Abs. 2 BV)") ∨ betrifft(a, "Wegweisung"))
let Exception8(a) = gebiet(a, "Ausländerrecht") ∧ betrifft(a, "vorläufige Aufnahme")
let Exception7(a, bew) = (((gebiet(a, "Ausländerrecht") ∧ betrifft(a, bew)) ∧ bewilligung(bew))
        ∧ ¬raeumtAnspruchEin("Bundesrecht", bew)) ∧ ¬raeumtAnspruchEin("Völkerrecht", bew)
let Exception6(a) = gebiet(a, "Ausländerrecht") ∧ betrifft(a, "Einreise")
let Exception5(a) = betrifft(a, "ordentliche Einbürgerung")
let Exception4(a) = gebiet(a, "auswärtige Angelegenheiten") ∧ ¬beurteilungsAnspruch("Völkerrecht", a)
let zulaessig(_p1, _p2) = ∃a. ∃b. ∃bew. (((((((((((((((anfechtungsObjekt(b, a) ∧ (betrifft(a, "politische Stimmberechtigung")
        ∨ betrifft(a, "Volkswahlen") ∨ betrifft(a, "Volksabstimmungen")))
        ∧ ¬Exception4(a)) ∧ ¬Exception5(a)) ∧ ¬Exception6(a)) ∧ ¬Exception7(a, bew)) ∧ ¬Exception8(a))
        ∧ ¬Exception9(a)) ∧ ¬Exception10(a)) ∧ ¬Exception11(a)) ∧ ¬Exception12(a))
        ∧ ¬Exception13(a, bew)) ∧ ¬Exception14(a)); _p1 <- "Bundesgericht", _p2 <- b)
    ∨ (((((((((((((anfechtungsObjekt(b, a) ∧ kantonalerErlass(a)) ∧ ¬Exception4(a))
        ∧ ¬Exception5(a)) ∧ ¬Exception6(a)) ∧ ¬Exception7(a, bew)) ∧ ¬Exception8(a)) ∧ ¬Exception9(a))
        ∧ ¬Exception10(a)) ∧ ¬Exception11(a)) ∧ ¬Exception12(a)) ∧ ¬Exception13(a, bew))
        ∧ ¬Exception14(a)); _p1 <- "Bundesgericht", _p2 <- b))
    ∨ (((((((((((((anfechtungsObjekt(b, a) ∧ oeffentlichesRecht(a)) ∧ ¬Exception4(a))
        ∧ ¬Exception5(a)) ∧ ¬Exception6(a)) ∧ ¬Exception7(a, bew)) ∧ ¬Exception8(a)) ∧ ¬Exception9(a))
        ∧ ¬Exception10(a)) ∧ ¬Exception11(a)) ∧ ¬Exception12(a)) ∧ ¬Exception13(a, bew))
        ∧ ¬Exception14(a)); _p1 <- "Bundesgericht", _p2 <- b))

□ ∀b. ∀g. (beurteilt(g, b) ∧:L ⊤) →:L zulaessig(g, b)