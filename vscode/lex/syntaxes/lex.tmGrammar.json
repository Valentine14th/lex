{
	"scopeName": "source.lex",
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Lex",
	"patterns": [
		{ "include": "#comment" },
		{ "include": "#formula" }
	],
	"repository": {
		"formula": {
			"patterns": [
				{
					"name": "string.regexp",
					"begin": "r\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.untitled",
							"match": "\\."
						}
					]
				},
				{
					"match": "(?i)\\b(equiv|implies|or|and|not|exists|forall)\\b",
					"name": "keyword.operator"
				},
				{
					"match": "\\?",
					"name": "keyword.operator"
				},
				{
					"match": "\\b(next|prev|once|eventually|historically|always|since|until|trigger|release)\\b",
					"name": "keyword.operator"
				},
				{
					"match": "\\b(fix|whenever|oblige|permit|constitute|except|scope|let|refine|assume|strengthen|weaken|by)\\b",
					"name": "keyword.control"
				},
				{
					"match": "\\b(law|title|chapter|section|article|paragraph|point|subpoint|import|causing|suppressing)\\b",
					"name": "keyword.other"
				},
				{
					"match": "\\b(type|is|event|predicate|rule|replace)\\b",
					"name": "storage.type"
				},
				{
					"match": "\\b(string|int|float|causable|suppressable|observable|internal|enforceable|transparently)\\b",
					"name": "support.type"
				},
				{
					"match": "\\b(false|true)\\b",
					"name": "constant.language.boolean"
				},
				{
					"include": "#bound"
				},
				{
					"include": "#predicate"
				},
				{
					"include": "#aggreg"
				},
				{
					"include": "#integer"
				},
				{
					"include": "#rational"
				},
				{
					"include": "#var"
				},
				{
					"name": "string.quoted.double",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.untitled",
							"match": "\\."
						}
					]
				}
			],
			"repository": {
				"predicate": {
					"patterns": [
						{
							"match": "(tpts|tp|ts)\\s*\\((.*)\\)",
							"captures": {
								"1": {
									"name": "keyword.operator"
								},
								"2": {
									"patterns": [
										{
											"include": "$self"
										}
									]
								}
							}
						}
					]
				},
				"var": {
					"name": "variable",
					"patterns": [
						{
							"match": "_",
							"name": "variable"
						},
						{
							"match": "\\b[a-zA-Z]+(?:\\w|-|\/|:|'|\")*",
							"name": "variable"
						}
					]
				},
				"bound": {
					"match": "\\b(-?[0-9]+)([smhd]?)\\b",
					"captures": {
						"1": {
							"name": "constant.numeric"
						},
						"2": {
							"name": "constant.unit"
						}
					}
				},
				"cst": {
					"name": "constant",
					"patterns": [
						{
							"include": "#rational"
						},
						{
							"include": "#integer"
						},
						{
							"name": "empty"
						}
					]
				},
				"integer": {
					"name": "constant.numeric",
					"match": "\\b-?[0-9]+\\b"
				},
				"rational": {
					"name": "constant.numeric",
					"match": "\\b-?[0-9]+\\.[0-9]*\\b"
				},
				"aggreg": {
					"match": "\\b(CNT|MIN|MAX|SUM|AVG|MED)\\b",
					"name": "keyword.operator"
				},
				"sString": {
					"name": "string.quoted.single",
					"begin": "'",
					"end": "'",
					"patterns": [
						{
							"name": "constant.character.escape.untitled",
							"match": "\\."
						}
					]
				},
				"dString": {
					"name": "string.quoted.double",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.untitled",
							"match": "\\."
						}
					]
				}
			}
		},
		"comment": {
			"patterns": [
				{
					"include": "#block-comment"
				},
				{
					"include": "#line-comment"
				}
			],
			"repository": {
				"line-comment": {
					"match": "#.*",
					"name": "comment.line"
				},
				"block-comment": {
					"begin": "\\(\\#",
					"end": "\\#\\)",
					"name": "comment.block"
				}
			}
		}
	}
}
