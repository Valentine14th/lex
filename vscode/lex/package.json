{
  "name": "lex",
  "displayName": "lex",
  "description": "Lex language extension",
  "publisher": "lex-lang",
  "version": "0.0.1",
  "engines": { "vscode": "^1.85.0" },
  "categories": [ "Other" ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lex.helloWorld",
        "title": "Hello World"
      }
    ],
    "languages": [
      {
        "id": "lex",
        "extensions": [".lex", ".rex"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lex",
        "scopeName": "source.lex",
        "path": "./syntaxes/lex.tmGrammar.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.3.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.3.9",
    "typescript": "^5.3.3"
  }
}
