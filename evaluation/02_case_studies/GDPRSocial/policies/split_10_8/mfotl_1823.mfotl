LET DataProcessing(_p176 : string, _p177 : string, _p178 : string, _p179 : string)- = ∃ds. ∃p. (((∃ds'. Read(_p179, ds, _p178, p, ds')) ∨:L (∃ds'. Write(_p179, ds, _p178, p, ds')) ∨:L Collect(_p178, _p179, ds, p)) ∧:L ((_p177) = "GDPRSocial, Inc.")) ∧:L ((_p176) = "GDPRSocial, Inc.") IN
LET HasIntendedRecipientCategory(_p155 : string, _p156 : string) = ⊥ ∨ (∃a. ∃ds. Collect(a, _p155, ds, "statistics") ∧ ((_p156) = "Analytics, Inc.")) IN
LET HasPurpose(_p153 : string, _p154 : string)- = ∃d. ∃ds. (∃ds'. Read(d, ds, _p153, _p154, ds')) ∨:L (∃ds'. Write(d, ds, _p153, _p154, ds')) ∨:L Collect(_p153, d, ds, _p154) IN
LET HasStorageCriteria(_p147 : string, _p148 : string) = ⊤ ∧ ((_p148) = "Your data is stored until you delete your account") IN
LET IsAccessRequest(_p143 : string) = ∃ds. RequestAccess(ds, _p143) IN
LET IsCategory(_p134 : string, _p135 : string)+ = (Declaration(_p134) ∧:L HasText(_p134, "<h6>Special categories of personal data</h6><p>Some of the personal data we process belongs to the following special category as defined in Article 9 GDPR: " ^ string_of_category(_p135) ^ ".</p>")) ∧:R NoteCategory(_p135) IN
LET IsDataProcessingOngoing(_p124 : string)+ = Declaration(_p124) ∧:L HasText(_p124, "<h6>Processing status</h6><p>We are currently processing your personal data. You may exercise your rights regarding this processing as described in the applicable privacy notice.</p>") IN
LET IsPurposeOfProcessing(_p113 : string, _p114 : string)+ = (((Declaration(_p113) ∧:L ((_p114) = "service" →:R HasText(_p113, "<h6>Processing for strictly necessary purposes</h6><p>We process your data to provide GDPRSocial's essential functionality.</p>"))) ∧:R ((_p114) = "personalized_ad" →:R HasText(_p113, "<h6>Processing for advertisement purposes</h6><p>We process your data to show you personalized advertisement.</p>"))) ∧:R ((_p114) = "statistics" →:R HasText(_p113, "<h6>Processing for statistical purposes</h6><p>We process your data to generate website statistics and analytics.</p>"))) ∧:R NotePurpose(_p114) IN
LET IsRecipient(_p101 : string, _p102 : string)+ = (Declaration(_p101) ∧:L HasText(_p101, "<h6>Recipients of your personal data</h6><p>We intend to share your personal data with the following entity: " ^ string_of_entity(_p102) ^ ".</p>")) ∧:R NoteEntity(_p102) IN
LET IsRecipientCategory(_p99 : string, _p100 : string)+ = (Declaration(_p99) ∧:L HasText(_p99, "<h6>Categories of recipients</h6><p>We intend to share your personal data with the following categories of entities: " ^ string_of_entity(_p100) ^ ".</p>")) ∧:R NoteEntity(_p100) IN
LET IsStorageCriteria(_p90 : string, _p91 : string)+ = (Declaration(_p90) ∧:L HasText(_p90, "<h6>Storage criteria</h6><p>The criteria used to determine the period for which your personal data will be stored are: " ^ string_of_criteria(_p91) ^ ".</p>")) ∧:R NoteCriteria(_p91) IN
LET RefuseRequest(_p286 : string, _p287 : string, _p288 : string)- = ⊥ IN
LET Request(_p140 : string, _p141 : string, _p142 : string) = (∃d. ∃d'. (ContestAccuracy(_p140, d, d') ∧ ((_p142) = "GDPRSocial, Inc.")) ∧ ((_p141) = "")) ∨ (∃d. ∃d'. RequestRectification(_p140, d, d', _p141) ∧ ((_p142) = "GDPRSocial, Inc.")) ∨ (∃d. RequestErasure(_p140, d, _p141) ∧ ((_p142) = "GDPRSocial, Inc.")) ∨ RequestAccess(_p140, _p141) ∧ ((_p142) = "GDPRSocial, Inc.") IN
LET RequestExtension(_p282 : string, _p283 : string)- = ⊥ IN
LET UndueDelay(_p273 : string) = ⊤ IN
