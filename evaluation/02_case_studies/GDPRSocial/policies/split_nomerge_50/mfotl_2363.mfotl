LET UndueDelay(_p280 : string) = ⊤ IN
LET Exception49(c : string, ds : string, rq : string) = ⧫[0s,∞) Request(ds, rq, c) ∧ RefuseRequest(c, rq, ds) IN
□[0s,∞) {"../Lex/example/GDPR/gdpr.lex:2363:1-2370:45"}{∀e. ∀rs. (∃c. ∃ds. ∃rq. (⧫[0s,∞) (Request(ds, rq, c) ∧ IsRecipientRequest(rq)) ∧ RequestResponse(ds, rq, rs)) ∧ ⧫[0s,∞) (∃d. Share(c, e, d) ∧ PersonalData(d, ds))) →:R (∃de. Contains(rs, de) ∧:L IsEffectiveRecipient(de, e))}
∧:R □[0s,∞) {"../Lex/example/GDPR/gdpr.lex:1009:1-1014:45"}{∀c. ∀ds. ∀rq. Request(ds, rq, c) ∧ ¬Exception49(c, ds, rq) →:R ¬UndueDelay(rq) U[0s,1M]:R (∃rs. RequestResponse(ds, rq, rs)) ∨:L RequestExtension(c, rq)}