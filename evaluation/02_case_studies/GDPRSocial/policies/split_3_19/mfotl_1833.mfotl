LET DataProcessing(_p183 : string, _p184 : string, _p185 : string, _p186 : string)- = ∃ds. ∃p. (((∃ds'. Read(_p186, ds, _p185, p, ds')) ∨:L (∃ds'. Write(_p186, ds, _p185, p, ds')) ∨:L Collect(_p185, _p186, ds, p)) ∧:L ((_p184) = "GDPRSocial, Inc.")) ∧:L ((_p183) = "GDPRSocial, Inc.") IN
LET HasPurpose(_p156 : string, _p157 : string)- = ∃d. ∃ds. (∃ds'. Read(d, ds, _p156, _p157, ds')) ∨:L (∃ds'. Write(d, ds, _p156, _p157, ds')) ∨:L Collect(_p156, d, ds, _p157) IN
LET IsAccessRequest(_p146 : string) = ∃ds. RequestAccess(ds, _p146) IN
LET IsCategory(_p140 : string, _p141 : string)+ = (Declaration(_p140) ∧:L HasText(_p140, "<h6>Special categories of personal data</h6><p>Some of the personal data we process belongs to the following special category as defined in Article 9 GDPR: " ^ string_of_category(_p141) ^ ".</p>")) ∧:R NoteCategory(_p141) IN
LET IsDataProcessingOngoing(_p130 : string)+ = Declaration(_p130) ∧:L HasText(_p130, "<h6>Processing status</h6><p>We are currently processing your personal data. You may exercise your rights regarding this processing as described in the applicable privacy notice.</p>") IN
LET IsPurposeOfProcessing(_p117 : string, _p118 : string)+ = (((Declaration(_p117) ∧:L ((_p118) = "service" →:R HasText(_p117, "<h6>Processing for strictly necessary purposes</h6><p>We process your data to provide GDPRSocial's essential functionality.</p>"))) ∧:R ((_p118) = "personalized_ad" →:R HasText(_p117, "<h6>Processing for advertisement purposes</h6><p>We process your data to show you personalized advertisement.</p>"))) ∧:R ((_p118) = "statistics" →:R HasText(_p117, "<h6>Processing for statistical purposes</h6><p>We process your data to generate website statistics and analytics.</p>"))) ∧:R NotePurpose(_p118) IN
LET RefuseRequest(_p293 : string, _p294 : string, _p295 : string)- = ⊥ IN
LET Request(_p99 : string, _p100 : string, _p101 : string) = (∃d. ∃d'. (ContestAccuracy(_p99, d, d') ∧ ((_p101) = "GDPRSocial, Inc.")) ∧ ((_p100) = "")) ∨ (∃d. ∃d'. RequestRectification(_p99, d, d', _p100) ∧ ((_p101) = "GDPRSocial, Inc.")) ∨ (∃d. RequestErasure(_p99, d, _p100) ∧ ((_p101) = "GDPRSocial, Inc.")) ∨ RequestAccess(_p99, _p100) ∧ ((_p101) = "GDPRSocial, Inc.") ∨ RequestRecipientInformation(_p99, _p100) ∧ ((_p101) = "GDPRSocial, Inc.") IN
LET RequestExtension(_p289 : string, _p290 : string)- = ⊥ IN
LET UndueDelay(_p280 : string) = ⊤ IN
LET Exception49(c : string, ds : string, rq : string) = ⧫[0s,∞) Request(ds, rq, c) ∧ RefuseRequest(c, rq, ds) IN
□[0s,∞) {"../Lex/example/GDPR/gdpr.lex:1833:1-1840:45"}{∀rs. (∃c. ∃ds. ∃rq. (⧫[0s,∞) (Request(ds, rq, c) ∧ IsAccessRequest(rq)) ∧ RequestResponse(ds, rq, rs)) ∧ (∃pr. ∃a. ∃d. ⧫[0s,∞) (DataProcessing(pr, c, a, d) ∧ PersonalData(d, ds)))) →:R (∃de. Contains(rs, de) ∧:L IsDataProcessingOngoing(de))}
