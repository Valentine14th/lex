LET HasIntendedAutomatedDecision(_p160 : string, _p161 : string) = ∃a. ∃ds. Collect(a, _p160, ds, "personalized_ad") ∧ ((_p161) = "We use the content of the page shown to the user to display personalized advertisement") IN
LET HasIntendedRecipientCategory(_p158 : string, _p159 : string) = ⊥ ∨ (∃a. ∃ds. Collect(a, _p158, ds, "statistics") ∧ ((_p159) = "Analytics, Inc.")) IN
LET HasPurpose(_p156 : string, _p157 : string)- = ∃d. ∃ds. (∃ds'. Read(d, ds, _p156, _p157, ds')) ∨:L (∃ds'. Write(d, ds, _p156, _p157, ds')) ∨:L Collect(_p156, d, ds, _p157) IN
