LET HasIntendedAutomatedDecision(_p157 : string, _p158 : string) = ∃a. ∃ds. Collect(a, _p157, ds, "personalized_ad") ∧ ((_p158) = "We use the content of the page shown to the user to display personalized advertisement") IN
LET HasIntendedRecipientCategory(_p155 : string, _p156 : string) = ⊥ ∨ (∃a. ∃ds. Collect(a, _p155, ds, "statistics") ∧ ((_p156) = "Analytics, Inc.")) IN
LET HasPurpose(_p153 : string, _p154 : string)- = ∃d. ∃ds. (∃ds'. Read(d, ds, _p153, _p154, ds')) ∨:L (∃ds'. Write(d, ds, _p153, _p154, ds')) ∨:L Collect(_p153, d, ds, _p154) IN
