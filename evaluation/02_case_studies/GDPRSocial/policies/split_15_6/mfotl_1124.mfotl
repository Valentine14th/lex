LET IsAutomatedDecision(_p137 : string)+ = Declaration(_p137) ∧:L HasText(_p137, "<h6>Automated decision-making</h6><p>We use the content of your latest posts to display personalized advertisement. No human review is involved in this decision.</p>") IN
LET IsCategory(_p134 : string, _p135 : string)+ = (Declaration(_p134) ∧:L HasText(_p134, "<h6>Special categories of personal data</h6><p>Some of the personal data we process belongs to the following special category as defined in Article 9 GDPR: " ^ string_of_category(_p135) ^ ".</p>")) ∧:R NoteCategory(_p135) IN
LET IsCollection(_p132 : string, _p133 : string) = ∃d. ∃p. Collect(_p132, d, _p133, p) IN
LET IsContactDetailsOfDataProtectionOfficer(_p128 : string, _p129 : string)+ = (Declaration(_p128) ∧:L HasText(_p128, "<h6>Contact details of the Data Protection Officer</h6><p>You can contact our Data Protection Officer at: " ^ string_of_entity(_p129) ^ ". The DPO can be reached for any queries related to the processing of your personal data or the exercise of your rights.</p>")) ∧:R NoteEntity(_p129) IN
LET IsDataProtectionOfficer(_p122 : string, _p123 : string) = ((_p122) = "GDPRSocial, Inc.") ∧ ((_p123) = "dpo@gdprsocial-inc.com") IN
LET IsIdentityOfControllerOrRepresentative(_p117 : string, _p118 : string)+ = (Declaration(_p117) ∧:L HasText(_p117, "<h6>Identity of the controller</h6><p>The controller responsible for the processing of your personal data is " ^ string_of_entity(_p118) ^ ".</p>")) ∧:R NoteEntity(_p118) IN
LET IsReasonablePeriod(_p302 : int, _p303 : int) = ⊥ IN
LET IsReception(_p300 : string, _p301 : string) = ⊥ IN
LET IsRecipient(_p101 : string, _p102 : string)+ = (Declaration(_p101) ∧:L HasText(_p101, "<h6>Recipients of your personal data</h6><p>We intend to share your personal data with the following entity: " ^ string_of_entity(_p102) ^ ".</p>")) ∧:R NoteEntity(_p102) IN
LET IsRecipientCategory(_p99 : string, _p100 : string)+ = (Declaration(_p99) ∧:L HasText(_p99, "<h6>Categories of recipients</h6><p>We intend to share your personal data with the following categories of entities: " ^ string_of_entity(_p100) ^ ".</p>")) ∧:R NoteEntity(_p100) IN
LET IsRightToLodgeComplaint(_p95 : string)+ = Declaration(_p95) ∧:L HasText(_p95, "<h6>Right to lodge a complaint</h6><p>You have the right to lodge a complaint with the competent National Data Protection Authority if you consider that the processing of your personal data infringes the GDPR, without prejudice to any other administrative or judicial remedy.</p>") IN
LET IsRightToWithdrawConsent(_p94 : string)+ = Declaration(_p94) ∧:L HasText(_p94, "<h6>Right to withdraw consent</h6><p>You have the right to withdraw consent for processing your data at any time.</p>") IN
LET IsRights(_p93 : string)+ = Declaration(_p93) ∧:L HasText(_p93, "<h6>Your rights as a data subject</h6><ul><li>You have the right to request access to, rectification of, or erasure of your personal data, or restriction of processing (Articles 15–18 GDPR).</li><li>You have the right to receive your personal data in a structured, commonly used, and machine-readable format and to transmit it to another controller (right to data portability, Article 20 GDPR).</li><li>You have the right to object to automated decision-making, including profiling (Article 22 GDPR).</li></ul>") IN
LET IsStorageCriteria(_p90 : string, _p91 : string)+ = (Declaration(_p90) ∧:L HasText(_p90, "<h6>Storage criteria</h6><p>The criteria used to determine the period for which your personal data will be stored are: " ^ string_of_criteria(_p91) ^ ".</p>")) ∧:R NoteCriteria(_p91) IN
LET UndueDataDelay(_p274 : string) = ⊤ IN
LET UseForCommunication(_p211 : string, _p212 : string) = ⊥ IN
