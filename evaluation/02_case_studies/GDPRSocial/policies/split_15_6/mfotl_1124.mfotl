LET DataProcessing(_p176 : string, _p177 : string, _p178 : string, _p179 : string)- = ∃ds. ∃p. (((∃ds'. Read(_p179, ds, _p178, p, ds')) ∨:L (∃ds'. Write(_p179, ds, _p178, p, ds')) ∨:L Collect(_p178, _p179, ds, p)) ∧:L ((_p177) = "GDPRSocial, Inc.")) ∧:L ((_p176) = "GDPRSocial, Inc.") IN
LET Disclose(_p172 : string, _p173 : string) = ∃a. ∃ds. ∃p. Read(_p172, ds, a, p, _p173) IN
LET DisproportionateEffortToInform(_p366 : string, _p367 : string, _p368 : string) = ⊥ IN
