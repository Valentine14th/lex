LET DataProcessing(_p183 : string, _p184 : string, _p185 : string, _p186 : string)- = ∃ds. ∃p. (((∃ds'. Read(_p186, ds, _p185, p, ds')) ∨:L (∃ds'. Write(_p186, ds, _p185, p, ds')) ∨:L Collect(_p185, _p186, ds, p)) ∧:L ((_p184) = "GDPRSocial, Inc.")) ∧:L ((_p183) = "GDPRSocial, Inc.") IN
LET IsCollection(_p138 : string, _p139 : string) = ∃d. ∃p. Collect(_p138, d, _p139, p) IN
LET IsContactDetailsOfDataProtectionOfficer(_p134 : string, _p135 : string)+ = (Declaration(_p134) ∧:L HasText(_p134, "<h6>Contact details of the Data Protection Officer</h6><p>You can contact our Data Protection Officer at: " ^ string_of_entity(_p135) ^ ". The DPO can be reached for any queries related to the processing of your personal data or the exercise of your rights.</p>")) ∧:R NoteEntity(_p135) IN
LET IsDataProtectionOfficer(_p128 : string, _p129 : string) = ((_p128) = "GDPRSocial, Inc.") ∧ ((_p129) = "dpo@gdprsocial-inc.com") IN
□[0s,∞) {"../Lex/example/GDPR/gdpr.lex:1132:1-1140:45"}{∀c. ∀c'. ∀ds. (∃a. ∃d. ∃pr. ((DataProcessing(pr, c, a, d) ∧ IsDataProtectionOfficer(c, c')) ∧ IsCollection(a, ds)) ∧ PersonalData(d, ds)) →:R ⧫[0s,∞) (∃de. ∃re. Inform(c, ds, de) ∧:L Contains(de, re) ∧:L IsContactDetailsOfDataProtectionOfficer(re, c'))}