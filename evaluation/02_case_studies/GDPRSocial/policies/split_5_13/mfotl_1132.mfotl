LET DataProcessing(_p183 : string, _p184 : string, _p185 : string, _p186 : string)- = ∃ds. ∃p. (((∃ds'. Read(_p186, ds, _p185, p, ds')) ∨:L (∃ds'. Write(_p186, ds, _p185, p, ds')) ∨:L Collect(_p185, _p186, ds, p)) ∧:L ((_p184) = "GDPRSocial, Inc.")) ∧:L ((_p183) = "GDPRSocial, Inc.") IN
LET HasIntendedRecipientCategory(_p158 : string, _p159 : string) = ⊥ ∨ (∃a. ∃ds. Collect(a, _p158, ds, "statistics") ∧ ((_p159) = "Analytics, Inc.")) IN
LET HasStorageCriteria(_p150 : string, _p151 : string) = ⊤ ∧ ((_p151) = "Your data is stored until you delete your account") IN
LET IsCollection(_p138 : string, _p139 : string) = ∃d. ∃p. Collect(_p138, d, _p139, p) IN
LET IsContactDetailsOfDataProtectionOfficer(_p134 : string, _p135 : string)+ = (Declaration(_p134) ∧:L HasText(_p134, "<h6>Contact details of the Data Protection Officer</h6><p>You can contact our Data Protection Officer at: " ^ string_of_entity(_p135) ^ ". The DPO can be reached for any queries related to the processing of your personal data or the exercise of your rights.</p>")) ∧:R NoteEntity(_p135) IN
LET IsDataProtectionOfficer(_p128 : string, _p129 : string) = ((_p128) = "GDPRSocial, Inc.") ∧ ((_p129) = "dpo@gdprsocial-inc.com") IN
LET IsRecipient(_p105 : string, _p106 : string)+ = (Declaration(_p105) ∧:L HasText(_p105, "<h6>Recipients of your personal data</h6><p>We intend to share your personal data with the following entity: " ^ string_of_entity(_p106) ^ ".</p>")) ∧:R NoteEntity(_p106) IN
LET IsRecipientCategory(_p103 : string, _p104 : string)+ = (Declaration(_p103) ∧:L HasText(_p103, "<h6>Categories of recipients</h6><p>We intend to share your personal data with the following categories of entities: " ^ string_of_entity(_p104) ^ ".</p>")) ∧:R NoteEntity(_p104) IN
LET IsRights(_p93 : string)+ = Declaration(_p93) ∧:L HasText(_p93, "<h6>Your rights as a data subject</h6><ul><li>You have the right to request access to, rectification of, or erasure of your personal data, or restriction of processing (Articles 15–18 GDPR).</li><li>You have the right to receive your personal data in a structured, commonly used, and machine-readable format and to transmit it to another controller (right to data portability, Article 20 GDPR).</li><li>You have the right to object to automated decision-making, including profiling (Article 22 GDPR).</li></ul>") IN
LET IsStorageCriteria(_p90 : string, _p91 : string)+ = (Declaration(_p90) ∧:L HasText(_p90, "<h6>Storage criteria</h6><p>The criteria used to determine the period for which your personal data will be stored are: " ^ string_of_criteria(_p91) ^ ".</p>")) ∧:R NoteCriteria(_p91) IN
□[0s,∞) {"../Lex/example/GDPR/gdpr.lex:1132:1-1140:45"}{∀c. ∀c'. ∀ds. (∃a. ∃d. ∃pr. ((DataProcessing(pr, c, a, d) ∧ IsDataProtectionOfficer(c, c')) ∧ IsCollection(a, ds)) ∧ PersonalData(d, ds)) →:R ⧫[0s,∞) (∃de. ∃re. Inform(c, ds, de) ∧:L Contains(de, re) ∧:L IsContactDetailsOfDataProtectionOfficer(re, c'))}
