∧:R □[0s,∞) {"../Lex/example/GDPR/gdpr.lex:1331:1-1339:45"}{∀c. ∀cr. ∀ds. (∃a. ∃d. ∃pr. ((DataProcessing(pr, c, a, d) ∧ IsCollection(a, ds)) ∧ PersonalData(d, ds)) ∧ HasStorageCriteria(d, cr)) →:R ⧫[0s,∞) (∃de. ∃re. Inform(c, ds, de) ∧:L Contains(de, re) ∧:L IsStorageCriteria(re, cr))}
∧:R □[0s,∞) {"../Lex/example/GDPR/gdpr.lex:1351:1-1358:45"}{∀c. ∀ds. (∃a. ∃d. ∃pr. (DataProcessing(pr, c, a, d) ∧ IsCollection(a, ds)) ∧ PersonalData(d, ds)) →:R ⧫[0s,∞) (∃de. ∃re. Inform(c, ds, de) ∧:L Contains(de, re) ∧:L IsRights(re))}