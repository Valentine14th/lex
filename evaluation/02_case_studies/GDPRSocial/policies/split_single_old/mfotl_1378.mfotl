LET DataProcessing(_p183 : string, _p184 : string, _p185 : string, _p186 : string)- = ∃ds. ∃p. (((∃ds'. Read(_p186, ds, _p185, p, ds')) ∨:L (∃ds'. Write(_p186, ds, _p185, p, ds')) ∨:L Collect(_p185, _p186, ds, p)) ∧:L ((_p184) = "GDPRSocial, Inc.")) ∧:L ((_p183) = "GDPRSocial, Inc.") IN
LET IsCollection(_p138 : string, _p139 : string) = ∃d. ∃p. Collect(_p138, d, _p139, p) IN
LET IsRightToLodgeComplaint(_p95 : string)+ = Declaration(_p95) ∧:L HasText(_p95, "<h6>Right to lodge a complaint</h6><p>You have the right to lodge a complaint with the competent National Data Protection Authority if you consider that the processing of your personal data infringes the GDPR, without prejudice to any other administrative or judicial remedy.</p>") IN
□[0s,∞) {"../Lex/example/GDPR/gdpr.lex:1378:1-1385:45"}{∀c. ∀ds. (∃a. ∃d. ∃pr. (DataProcessing(pr, c, a, d) ∧ IsCollection(a, ds)) ∧ PersonalData(d, ds)) →:R ⧫[0s,∞) (∃de. ∃re. Inform(c, ds, de) ∧:L Contains(de, re) ∧:L IsRightToLodgeComplaint(re))}