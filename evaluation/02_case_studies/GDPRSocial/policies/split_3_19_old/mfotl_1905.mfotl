LET DataProcessing(_p176 : string, _p177 : string, _p178 : string, _p179 : string)- = ∃ds. ∃p. (((∃ds'. Read(_p179, ds, _p178, p, ds')) ∨:L (∃ds'. Write(_p179, ds, _p178, p, ds')) ∨:L Collect(_p178, _p179, ds, p)) ∧:L ((_p177) = "GDPRSocial, Inc.")) ∧:L ((_p176) = "GDPRSocial, Inc.") IN
LET HasIntendedAutomatedDecision(_p157 : string, _p158 : string) = ∃a. ∃ds. Collect(a, _p157, ds, "personalized_ad") ∧ ((_p158) = "We use the content of the page shown to the user to display personalized advertisement") IN
LET IsAccessRequest(_p143 : string) = ∃ds. RequestAccess(ds, _p143) IN
LET IsAutomatedDecision(_p137 : string)+ = Declaration(_p137) ∧:L HasText(_p137, "<h6>Automated decision-making</h6><p>We use the content of your latest posts to display personalized advertisement. No human review is involved in this decision.</p>") IN
LET IsComplaintStatement(_p130 : string, _p131 : string)+ = (Declaration(_p130) ∧:L HasText(_p130, "<h6>Right to lodge a complaint</h6><p>You have the right to lodge a complaint with the competent National Data Protection Authority regarding request " ^ string_of_request(_p131) ^ ". You may do so without prejudice to any other administrative or judicial remedy.</p>")) ∧:R NoteRequest(_p131) IN
LET IsRights(_p93 : string)+ = Declaration(_p93) ∧:L HasText(_p93, "<h6>Your rights as a data subject</h6><ul><li>You have the right to request access to, rectification of, or erasure of your personal data, or restriction of processing (Articles 15–18 GDPR).</li><li>You have the right to receive your personal data in a structured, commonly used, and machine-readable format and to transmit it to another controller (right to data portability, Article 20 GDPR).</li><li>You have the right to object to automated decision-making, including profiling (Article 22 GDPR).</li></ul>") IN
LET RefuseRequest(_p286 : string, _p287 : string, _p288 : string)- = ⊥ IN
LET Request(_p140 : string, _p141 : string, _p142 : string) = (∃d. ∃d'. (ContestAccuracy(_p140, d, d') ∧ ((_p142) = "GDPRSocial, Inc.")) ∧ ((_p141) = "")) ∨ (∃d. ∃d'. RequestRectification(_p140, d, d', _p141) ∧ ((_p142) = "GDPRSocial, Inc.")) ∨ (∃d. RequestErasure(_p140, d, _p141) ∧ ((_p142) = "GDPRSocial, Inc.")) ∨ RequestAccess(_p140, _p141) ∧ ((_p142) = "GDPRSocial, Inc.") IN
LET RequestExtension(_p282 : string, _p283 : string)- = ⊥ IN
LET UndueDelay(_p273 : string) = ⊤ IN
LET Exception49(c : string, ds : string, rq : string) = ⧫[0s,∞) Request(ds, rq, c) ∧ RefuseRequest(c, rq, ds) IN
□[0s,∞) {"../Lex/example/GDPR/gdpr.lex:1905:1-1912:45"}{∀rs. (∃c. ∃ds. ∃rq. (⧫[0s,∞) (Request(ds, rq, c) ∧ IsAccessRequest(rq)) ∧ RequestResponse(ds, rq, rs)) ∧ (∃pr. ∃a. ∃d. ⧫[0s,∞) DataProcessing(pr, c, a, d) ∧ PersonalData(d, ds))) →:R (∃de. Contains(rs, de) ∧:L IsRights(de))}
