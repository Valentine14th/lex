∧:R □[0s,∞) {"../Lex/example/GDPR/gdpr.lex:1947:1-1954:45"}{∀rs. (∃c. ∃de. ∃ds. ∃rq. (⧫[0s,∞) (Request(ds, rq, c) ∧ IsAccessRequest(rq)) ∧ RequestResponse(ds, rq, rs)) ∧ (∃pr. ∃a. ∃d. ⧫[0s,∞) (DataProcessing(pr, c, a, d) ∧ PersonalData(d, ds) ∧ HasIntendedAutomatedDecision(d, de)))) →:R (∃de. Contains(rs, de) ∧:L IsAutomatedDecision(de))}
∧:R □[0s,∞) {"../Lex/example/GDPR/gdpr.lex:1001:1-1006:45"}{∀c. ∀ds. ∀rq. Request(ds, rq, c) ∧ ¬Exception49(c, ds, rq) →:R ¬UndueDelay(rq) U[0s,1M]:R (∃rs. RequestResponse(ds, rq, rs)) ∨:L RequestExtension(c, rq)}