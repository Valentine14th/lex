LET DataProcessing(_p176 : string, _p177 : string, _p178 : string, _p179 : string)- = ∃ds. ∃p. (((∃ds'. Read(_p179, ds, _p178, p, ds')) ∨:L (∃ds'. Write(_p179, ds, _p178, p, ds')) ∨:L Collect(_p178, _p179, ds, p)) ∧:L ((_p177) = "GDPRSocial, Inc.")) ∧:L ((_p176) = "GDPRSocial, Inc.") IN
LET GiveConsent(_p169 : string, _p170 : string, _p171 : string)- = (Consent(_p169, _p170) ∨:L (∃sp. SpecialConsent(_p169, _p170, sp))) ∧:L ((_p171) = "GDPRSocial, Inc.") IN
LET IsCollection(_p132 : string, _p133 : string) = ∃d. ∃p. Collect(_p132, d, _p133, p) IN
LET IsContactDetailsOfDataProtectionOfficer(_p128 : string, _p129 : string)+ = (Declaration(_p128) ∧:L HasText(_p128, "<h6>Contact details of the Data Protection Officer</h6><p>You can contact our Data Protection Officer at: " ^ string_of_entity(_p129) ^ ". The DPO can be reached for any queries related to the processing of your personal data or the exercise of your rights.</p>")) ∧:R NoteEntity(_p129) IN
LET IsDataProtectionOfficer(_p122 : string, _p123 : string) = ((_p122) = "GDPRSocial, Inc.") ∧ ((_p123) = "dpo@gdprsocial-inc.com") IN
LET IsRightToWithdrawConsent(_p94 : string)+ = Declaration(_p94) ∧:L HasText(_p94, "<h6>Right to withdraw consent</h6><p>You have the right to withdraw consent for processing your data at any time.</p>") IN
□[0s,∞) {"../Lex/example/GDPR/gdpr.lex:537:1-542:45"}{∀c. ∀ds. (∃p. GiveConsent(ds, p, c)) →:R ⧫[0s,∞) (∃de. ∃re. Inform(c, ds, de) ∧:L Contains(de, re) ∧:L IsRightToWithdrawConsent(re))}
∧:R □[0s,∞) {"../Lex/example/GDPR/gdpr.lex:1124:1-1132:45"}{∀c. ∀c'. ∀ds. (∃a. ∃d. ∃pr. ((DataProcessing(pr, c, a, d) ∧ IsDataProtectionOfficer(c, c')) ∧ IsCollection(a, ds)) ∧ PersonalData(d, ds)) →:R ⧫[0s,∞) (∃de. ∃re. Inform(c, ds, de) ∧:L Contains(de, re) ∧:L IsContactDetailsOfDataProtectionOfficer(re, c'))}